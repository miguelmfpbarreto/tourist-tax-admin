<?xml version="1.0" encoding="utf-8"?>
<configuration><system.webServer><rewrite><rules><rule name="Tourist Tax Admin" stopProcessing="true"><match url="(.*)"/><action type="Rewrite" url="http://127.0.0.1:3001/{R:1}"/></rule></rules></rewrite><proxy enabled="true" preserveHostHeader="true"/><httpErrors existingResponse="PassThrough"/></system.webServer></configuration>
